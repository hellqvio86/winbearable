#!/usr/bin/env bash
set -euo pipefail
export MSYS_NO_PATHCONV=1

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}"

# renovate: datasource=docker depName=trufflesecurity/trufflehog
TRUFFLEHOG_VERSION="3.99.9"
# renovate: datasource=docker depName=aquasec/trivy
TRIVY_VERSION="0.76.2"

if [[ -d "${HOME}/.local/bin" && ":${PATH}:" != *":${HOME}/.local/bin:"* ]]; then
    export PATH="${HOME}/.local/bin:${PATH}"
fi
case "$(uname -s 2>/dev/null || echo "")" in
    MINGW*|MSYS*|CYGWIN*)
        if [[ -d "${REPO_ROOT}/.venv/Scripts" ]]; then
            export PATH="${REPO_ROOT}/.venv/Scripts:${PATH}"
        elif [[ -n "${TEMP:-}" ]]; then
            export UV_PROJECT_ENVIRONMENT="${TEMP}/wb-venv-win"
            if [[ -d "${TEMP}/wb-venv-win/Scripts" ]]; then
                export PATH="$(cygpath -u "${TEMP}")/wb-venv-win/Scripts:${PATH}"
            fi
        fi
        ;;
    *)
        if [[ -d "${REPO_ROOT}/.venv/bin" ]]; then
            export PATH="${REPO_ROOT}/.venv/bin:${PATH}"
        fi
        ;;
esac

# Enable real Windows integration tests automatically when pre-commit runs on Windows
case "$(uname -s 2>/dev/null || echo "")" in
    MINGW*|MSYS*|CYGWIN*) export WINBEARABLE_RUN_WINDOWS_INTEGRATION=1 ;;
    *)
        if [[ "${OS:-}" == "Windows_NT" ]]; then
            export WINBEARABLE_RUN_WINDOWS_INTEGRATION=1
        fi
        ;;
esac

run_docker() {
    if docker info >/dev/null 2>&1; then
        docker "$@"
    elif command -v sg >/dev/null 2>&1; then
        sg docker -c "docker $*"
    else
        docker "$@"
    fi
}

echo "=========================================="
echo "Running pre-commit quality & security gates..."
echo "=========================================="

echo "--> [1/4] Running Ruff lint & format check..."
if command -v uv >/dev/null 2>&1; then
    uv run --no-sync ruff check .
    uv run --no-sync ruff format --check .
elif [[ -x "${REPO_ROOT}/.venv/bin/ruff" ]]; then
    "${REPO_ROOT}/.venv/bin/ruff" check .
    "${REPO_ROOT}/.venv/bin/ruff" format --check .
else
    echo "ERROR: uv or repo .venv ruff is required for pre-commit lint/format checks!" >&2
    exit 1
fi

echo "--> [2/4] Running Mypy strict type check & Pytest suite..."
if command -v uv >/dev/null 2>&1; then
    uv run --no-sync mypy src
    uv run --no-sync pytest --cov=src/winbearable --cov-report=term-missing --cov-fail-under=89
elif [[ -x "${REPO_ROOT}/.venv/bin/mypy" && -x "${REPO_ROOT}/.venv/bin/pytest" ]]; then
    "${REPO_ROOT}/.venv/bin/mypy" src
    "${REPO_ROOT}/.venv/bin/pytest" --cov=src/winbearable --cov-report=term-missing --cov-fail-under=89
else
    echo "ERROR: uv or repo .venv mypy/pytest is required for pre-commit test checks!" >&2
    exit 1
fi

to_wsl_path() {
    local p="$1"
    if [[ "$p" =~ ^/([a-zA-Z])/(.*)$ ]]; then
        echo "/mnt/${BASH_REMATCH[1],,}/${BASH_REMATCH[2]}"
    elif [[ -n "${WINBEARABLE_WSL_DISTRO:-}" ]]; then
        wsl.exe -d "${WINBEARABLE_WSL_DISTRO}" -- wslpath -a "$p" | tr -d '\r'
    else
        wsl.exe -- wslpath -a "$p" | tr -d '\r'
    fi
}

run_wsl_docker() {
    if [[ -n "${WINBEARABLE_WSL_DISTRO:-}" ]]; then
        wsl.exe -d "${WINBEARABLE_WSL_DISTRO}" -- docker "$@"
    else
        wsl.exe -- docker "$@"
    fi
}

echo "--> [3/4] Running TruffleHog secret scan (container)..."
if command -v docker >/dev/null 2>&1; then
    run_docker run --rm -v "$REPO_ROOT":/src -w /src "trufflesecurity/trufflehog:${TRUFFLEHOG_VERSION}" git file:///src --only-verified --fail
elif command -v docker.exe >/dev/null 2>&1; then
    WIN_REPO="$(cygpath -w "$REPO_ROOT" 2>/dev/null || wslpath -w "$REPO_ROOT")"
    docker.exe run --rm -v "${WIN_REPO}:/src" -w /src "trufflesecurity/trufflehog:${TRUFFLEHOG_VERSION}" git file:///src --only-verified --fail
elif command -v wsl.exe >/dev/null 2>&1; then
    WSL_REPO="$(to_wsl_path "$REPO_ROOT")"
    run_wsl_docker run --rm -v "${WSL_REPO}:/src" -w /src "trufflesecurity/trufflehog:${TRUFFLEHOG_VERSION}" git file:///src --only-verified --fail
else
    echo "ERROR: docker is required to run TruffleHog container!" >&2
    exit 1
fi

echo "--> [4/4] Running Trivy vulnerability scan (container)..."
if command -v docker >/dev/null 2>&1; then
    run_docker run --rm -v "$REPO_ROOT":/src -v trivy-cache:/root/.cache -w /src "aquasec/trivy:${TRIVY_VERSION}" fs --scanners vuln --skip-dirs .venv,.venv-win,.mypy_cache,.ruff_cache,.pytest_cache --severity HIGH,CRITICAL --exit-code 1 .
elif command -v docker.exe >/dev/null 2>&1; then
    WIN_REPO="$(cygpath -w "$REPO_ROOT" 2>/dev/null || wslpath -w "$REPO_ROOT")"
    docker.exe run --rm -v "${WIN_REPO}:/src" -v trivy-cache:/root/.cache -w /src "aquasec/trivy:${TRIVY_VERSION}" fs --scanners vuln --skip-dirs .venv,.venv-win,.mypy_cache,.ruff_cache,.pytest_cache --severity HIGH,CRITICAL --exit-code 1 .
elif command -v wsl.exe >/dev/null 2>&1; then
    WSL_REPO="$(to_wsl_path "$REPO_ROOT")"
    run_wsl_docker run --rm -v "${WSL_REPO}:/src" -v trivy-cache:/root/.cache -w /src "aquasec/trivy:${TRIVY_VERSION}" fs --scanners vuln --skip-dirs .venv,.venv-win,.mypy_cache,.ruff_cache,.pytest_cache --severity HIGH,CRITICAL --exit-code 1 .
else
    echo "ERROR: docker is required to run Trivy container!" >&2
    exit 1
fi

echo "=========================================="
echo "All pre-commit format, lint, test & container security checks passed!"
echo "=========================================="

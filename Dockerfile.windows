# Local Windows integration-test container (requires Docker Desktop in Windows-container mode).
# Build: docker build -f Dockerfile.windows -t winbearable-win-test .
# Run:   docker run --rm winbearable-win-test
FROM mcr.microsoft.com/windows/servercore:ltsc2022

SHELL ["cmd", "/S", "/C"]

ADD https://www.python.org/ftp/python/3.13.2/python-3.13.2-amd64.exe C:\\python-installer.exe
RUN C:\\python-installer.exe /quiet InstallAllUsers=1 PrependPath=1 Include_test=0 && del C:\\python-installer.exe

WORKDIR C:\\app
COPY pyproject.toml uv.lock* README.md ./
COPY src ./src
COPY tests ./tests

RUN python -m pip install --no-cache-dir -e ".[dev]" || python -m pip install --no-cache-dir -e . pytest pytest-cov

ENV WINBEARABLE_RUN_WINDOWS_INTEGRATION=1
CMD ["python", "-m", "pytest", "tests/test_windows_integration.py", "-v"]

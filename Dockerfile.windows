# Local Windows integration-test container (requires Docker Desktop in Windows-container mode).
# Build: docker build -f Dockerfile.windows -t winbearable-win-test .
# Run:   docker run --rm winbearable-win-test
FROM mcr.microsoft.com/windows/servercore:ltsc2022@sha256:f1a914079973258061ddbc95a9af579eab2ee252a6fddb254b1be5d769761acd

SHELL ["cmd", "/S", "/C"]

ADD https://www.python.org/ftp/python/3.13.2/python-3.13.2-amd64.exe C:\\python-installer.exe
RUN certutil -hashfile C:\python-installer.exe SHA256 | findstr /I "9aaa1075d0bd3e8abd0623d2d05de692ff00780579e1b232f259028bac19bb51" && C:\python-installer.exe /quiet InstallAllUsers=1 PrependPath=1 Include_test=0 && del C:\python-installer.exe

WORKDIR C:\\app
COPY pyproject.toml uv.lock* README.md ./
COPY profiles ./profiles
COPY src ./src

RUN python -m pip install --no-cache-dir -e . pytest pytest-cov

ENV WINBEARABLE_RUN_WINDOWS_INTEGRATION=1
CMD ["python", "-m", "pytest", "src/tests/test_windows_integration.py", "-v"]

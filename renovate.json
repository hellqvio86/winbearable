{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "automerge": false,
  "gitAuthor": "Olof Hellqvist <olof.hellqvist@gmail.com>",
  "github-actions": {
    "enabled": true
  },
  "dockerfile": {
    "enabled": true,
    "pinDigests": true
  },
  "docker-compose": {
    "enabled": true,
    "pinDigests": true
  },
  "devcontainer": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Docker container images in .githooks/pre-commit and Makefile",
      "fileMatch": [
        "^\\.githooks/pre-commit$",
        "^Makefile$"
      ],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>[^\\s]+)\\n\\s*[A-Z_]+\\s*[:?]?=\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Group Python dependencies",
      "matchManagers": [
        "pep621",
        "pip_requirements",
        "pip_setup"
      ],
      "groupName": "python-dependencies",
      "groupSlug": "python-deps"
    },
    {
      "description": "Group and pin GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions",
      "groupSlug": "github-actions",
      "pinDigests": true
    },
    {
      "description": "Pin container image digests",
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "devcontainer",
        "custom.regex"
      ],
      "groupName": "container-images",
      "groupSlug": "containers",
      "pinDigests": true
    }
  ],
  "rebaseWhen": "behind-base-branch"
}
